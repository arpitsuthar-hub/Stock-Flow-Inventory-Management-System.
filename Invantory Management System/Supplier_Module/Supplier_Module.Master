<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Supplier_Module.master.cs"
    Inherits="Inventory_Management_System.Supplier.Supplier_Module" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>Supplier Management</title>

    <!-- Supplier Module CSS -->
    <link href="../CSS/Supplier_Module.css?v=2" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <asp:ContentPlaceHolder ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1" runat="server">


        <!-- =====================================================
         SUPPLIER MODULE HEADER
         ===================================================== -->

        <header class="supplier-header">


            <!-- LEFT : MODULE NAME -->

            <div class="supplier-brand">

                <div class="brand-icon">

                    <i class="fa-solid fa-truck"></i>

                </div>


                <div class="brand-text">

                    <h1>Supplier Management
                    </h1>

                    <span>Inventory Management System
                    </span>

                </div>

            </div>

            <div class="stock-flow-title">
                STOCK FLOW
            </div>
            <!-- RIGHT : DATE -->

            <div class="header-date">

                <div class="date-icon">

                    <i class="fa-regular fa-calendar-days"></i>

                </div>


                <div class="date-content">

                    <span class="date-label">TODAY
                    </span>


                    <asp:Label
                        ID="lblDate"
                        runat="server"
                        CssClass="current-date">
                    </asp:Label>

                </div>

            </div>

        </header>


        <!-- =====================================================
         HORIZONTAL NAVBAR
         ===================================================== -->

        <nav class="supplier-navbar">

            <div class="navbar-container">


                <!-- DASHBOARD -->

                <a href="Supplier_Dashboard.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-house"></i>

                    <span>Dashboard
                    </span>

                </a>


                <!-- ADD SUPPLIER -->

                <a href="Supplier_AddNew.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-user-plus"></i>

                    <span>Add Supplier
                    </span>

                </a>


                <!-- SEARCH SUPPLIER -->

                <a href="Supplier_Search.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <span>Search Supplier
                    </span>

                </a>


                <!-- ALL SUPPLIERS -->

                <a href="AllSupplier.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-truck-field"></i>

                    <span>All Suppliers
                    </span>

                </a>


                <!-- BACK TO MAIN -->

                <a href="../Admin_Dashboard.aspx"
                    class="nav-item nav-back">

                    <i class="fa-solid fa-arrow-left"></i>

                    <span>Admin Dashboard
                    </span>

                </a>

            </div>

        </nav>


        <!-- =====================================================
         PAGE CONTENT
         ===================================================== -->

        <main class="supplier-content">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>


        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <footer class="supplier-footer">


            <div>

                <i class="fa-solid fa-boxes-stacked"></i>

                <span>Inventory Management System
                </span>

            </div>


            <div>
                Supplier Management Module
            </div>


        </footer>


        <!-- =====================================================
         DATE SCRIPT
         ===================================================== -->

        <script>

        document.addEventListener("DOMContentLoaded", function () {

            const dateLabel =
                document.getElementById(
                    '<%= lblDate.ClientID %>'
                );

            if (dateLabel) {

                const today = new Date();

                const options = {
                    weekday: 'long',
                    day: '2-digit',
                    month: 'long',
                    year: 'numeric'
                };

                dateLabel.textContent =
                    today.toLocaleDateString(
                        'en-IN',
                        options
                    );

            }

        });

        </script>


    </form>

</body>
</html>
