<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Product_Module.Master.cs"
    Inherits="Inventory_Management_System.Product_Module.Produt_Module" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>Product Management</title>

    <!-- Product Module CSS -->
    <link href="../CSS/Product_Module.css?v=2" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <asp:ContentPlaceHolder ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1" runat="server">

        <!-- =====================================================
         PRODUCT MODULE HEADER
         ===================================================== -->

        <header class="product-header">

            <!-- Left : Module Name -->

            <div class="product-brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <div class="brand-text">

                    <h1>Product Management</h1>

                    <span>Inventory Management System
                    </span>

                </div>

            </div>

            <div class="stock-flow-title">
                STOCK FLOW
            </div>

            <!-- Right : Date -->

            <div class="header-date">

                <div class="date-icon">
                    <i class="fa-regular fa-calendar-days"></i>
                </div>

                <div class="date-content">

                    <span class="date-label">TODAY
                    </span>

                    <asp:Label
                        ID="lblDate"
                        runat="server"
                        CssClass="current-date">
                    </asp:Label>

                </div>

            </div>

        </header>


        <!-- =====================================================
         HORIZONTAL NAVBAR
         ===================================================== -->

        <nav class="product-navbar">

            <div class="navbar-container">


                <!-- Dashboard -->

                <a href="Product_Dashboard.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-house"></i>

                    <span>Dashboard</span>

                </a>


                <!-- Add Product -->

                <a href="Product_AddNew.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-box"></i>

                    <span>Add Product</span>

                </a>


                <!-- Search Product -->

                <a href="Product_Search.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <span>Search Product</span>

                </a>


                <!-- All Products -->

                <a href="AllProduct.aspx"
                    class="nav-item">

                    <i class="fa-solid fa-boxes-stacked"></i>

                    <span>All Products</span>

                </a>


                <!-- Back to Main -->

                <a href="../Admin_Dashboard.aspx"
                    class="nav-item nav-back">

                    <i class="fa-solid fa-arrow-left"></i>

                    <span>Admin Dashboard</span>

                </a>

            </div>

        </nav>


        <!-- =====================================================
         PAGE CONTENT
         ===================================================== -->

        <main class="product-content">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>


        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <footer class="product-footer">

            <div>

                <i class="fa-solid fa-boxes-stacked"></i>

                <span>Inventory Management System
                </span>

            </div>

            <div>
                Product Management Module
            </div>

        </footer>


        <!-- =====================================================
         DATE SCRIPT
         ===================================================== -->

        <script>

        document.addEventListener("DOMContentLoaded", function () {

            const dateLabel =
                document.getElementById(
                    '<%= lblDate.ClientID %>'
                );

            if (dateLabel) {

                const today = new Date();

                const options = {
                    weekday: 'long',
                    day: '2-digit',
                    month: 'long',
                    year: 'numeric'
                };

                dateLabel.textContent =
                    today.toLocaleDateString(
                        'en-IN',
                        options
                    );

            }

        });

        </script>


    </form>

</body>
</html>
